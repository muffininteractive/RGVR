{
    "name": "wacky-works-vr",
    "version": "1.0.0",
    "description": "Wacky Works VR - An interactive virtual reality puzzle game built with A-Frame",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && npm run generate-sitemap",
        "build:watch": "vite build --watch",
        "preview": "vite preview",
        "serve": "vite preview --port 3000",
        "server": "node server.js",
        "editor": "concurrently \"npm run dev\" \"npm run server\"",
        "clean": "rm -rf dist node_modules/.vite",
        "lint": "eslint . --ext .js,.html",
        "format": "prettier --write .",
        "generate-sitemap": "node scripts/generate-sitemap.js",
        "deploy": "npm run build && npm run deploy:vercel",
        "deploy:vercel": "vercel --prod",
        "deploy:github": "npm run build && npm run deploy:github:pages",
        "deploy:github:pages": "gh-pages -d dist"
    },
    "keywords": [
        "aframe",
        "webxr",
        "vr",
        "ar",
        "3d",
        "virtual-reality",
        "augmented-reality",
        "webvr"
    ],
    "author": "Hugo Euzébio",
    "license": "MIT",
    "devDependencies": {
        "@vitejs/plugin-legacy": "^5.4.0",
        "concurrently": "^9.2.1",
        "eslint": "^8.54.0",
        "prettier": "^3.1.0",
        "terser": "^5.24.0",
        "vite": "^5.4.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/seu-usuario/rgvr-aframe-project.git"
    },
    "bugs": {
        "url": "https://github.com/seu-usuario/rgvr-aframe-project/issues"
    },
    "homepage": "https://github.com/seu-usuario/rgvr-aframe-project#readme",
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "bulma": "^1.0.4",
        "express": "^5.1.0"
    }
}